    "build:client": "npm run build --prefix client"
  },
  "keywords": [
    "travel",
    "luxury",
    "aggregator",
    "amadeus",
    "rome2rio",
    "booking",
    "itinerary",
    "mern"
  ],
  "author": "Voyager Luxe Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}
