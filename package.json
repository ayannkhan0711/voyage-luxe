{
  "name": "voyager-luxe",
  "version": "1.0.0",
  "description": "Voyager Luxe - Premium AI Travel Aggregator Platform",
  "private": true,
  "scripts": {
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
