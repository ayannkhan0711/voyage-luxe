# Voyager Luxe - Server Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/voyager_luxe

# JWT Secrets
JWT_SECRET=voyager_luxe_ultra_secure_jwt_secret_key_2026_luxury_brown_gold
